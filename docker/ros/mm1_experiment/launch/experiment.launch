<?xml version="1.0"?>
<launch>
  <arg name="execution_mode" default="rviz"/>
  <arg name="trena_mode" default="$(eval 'tcp' if arg('execution_mode') == 'hardware' else 'simulated')"/>
  <arg name="trena_host" default="$(eval optenv('LAB_HOST') or '127.0.0.1')"/>
  <arg name="trena_port" default="$(optenv LAB_PORT 5000)"/>
  <arg name="timeout" default="$(optenv LAB_TIMEOUT 5)"/>
  <arg name="output_dir" default="/data"/>
  <arg name="robot_ip" default="192.168.1.10"/>
  <arg name="robot_name" default="my_gen3"/>
  <arg name="start_driver" default="true"/>
  <arg name="start_rviz" default="true"/>
  <arg name="vision" default="true"/>
  <arg name="first_tilt_deg" default="120.0"/>
  <arg name="captures_per_pose" default="5"/>
  <arg name="hold_sec" default="1.0"/>
  <arg name="visual_move_sec" default="2.0"/>
  <arg name="position_tolerance_deg" default="0.1"/>
  <arg name="velocity_tolerance_deg_s" default="0.5"/>

  <include file="$(find kinova_geomagic_demo)/launch/demo_kinova_spherical_sweep.launch">
    <arg name="start_sweep" value="false"/>
    <arg name="execution_mode" value="$(arg execution_mode)"/>
    <arg name="start_driver" value="$(arg start_driver)"/>
    <arg name="start_rviz" value="$(arg start_rviz)"/>
    <arg name="robot_ip" value="$(arg robot_ip)"/>
    <arg name="robot_name" value="$(arg robot_name)"/>
    <arg name="vision" value="$(arg vision)"/>
  </include>
  <node pkg="mm1_experiment" type="experiment_node.py" name="mm1_experiment"
        output="screen" required="true"
        args="--captures-per-pose $(arg captures_per_pose) --execution-mode $(arg execution_mode) --trena-mode $(arg trena_mode) --host '$(arg trena_host)' --port $(arg trena_port) --timeout $(arg timeout) --hold-sec $(arg hold_sec) --first-tilt-deg $(arg first_tilt_deg) --output-dir '$(arg output_dir)'">
    <param name="robot_name" value="$(arg robot_name)"/>
    <param name="robot_ip" value="$(arg robot_ip)"/>
    <param name="vision" value="$(arg vision)"/>
    <param name="visual_move_sec" value="$(arg visual_move_sec)"/>
    <param name="position_tolerance_deg" value="$(arg position_tolerance_deg)"/>
    <param name="velocity_tolerance_deg_s" value="$(arg velocity_tolerance_deg_s)"/>
  </node>
</launch>
