# Copy to docker/.env and pass --env-file docker/.env from the repository root.
# Use the IPv4 address printed by the board. No Wi-Fi credentials are needed.
LAB_HOST=192.168.1.123
LAB_PORT=5000
LAB_TIMEOUT=5

# Optional JSONL log inside the persistent docker/data directory.
LAB_STATUS_LOG=
# LAB_STATUS_LOG=/data/status.jsonl

# Set these to the output of id -u and id -g, especially when saving logs.
LAB_UID=1000
LAB_GID=1000
